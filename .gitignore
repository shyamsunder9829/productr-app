# Root .gitignore for the entire project

# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
/dist
/build
*/dist
*/build

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
*.tmp

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Package lock files
package-lock.json
yarn.lock

# Cache
.npm
.cache/
.parcel-cache

# Vite
.vite/
vite.config.js.timestamp-*

# Database
*.db
*.sqlite
*.sqlite3

# Uploads
uploads/*
!uploads/.gitkeep
